NODE_ENV=development

PORT=5000

DATABASE_URL=postgresql://emergency_user:emergency_password@localhost:5432/emergency_response

REDIS_URL=redis://localhost:6379

JWT_SECRET=replace_with_secure_secret

FRONTEND_URL=http://localhost:5173

# MapmyIndia
MAPMYINDIA_CLIENT_ID=
MAPMYINDIA_CLIENT_SECRET=
MAPMYINDIA_ACCESS_TOKEN=

# Waze
WAZE_API_KEY=

# Optional fallback provider
FALLBACK_ROUTING_PROVIDER=

# Logging
LOG_LEVEL=info